# systemd unit for hyrox-radar. Install with:
#   sudo cp hyrox-radar.service /etc/systemd/system/
#   sudo systemctl enable --now hyrox-radar
[Unit]
Description=HYROX Radar: ticket watch with a dashboard
After=network-online.target
Wants=network-online.target

[Service]
User=pi
ExecStart=/usr/local/bin/hyrox-radar -listen :8590
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
